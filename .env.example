# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco de desenvolvimento, usado pelas migrações (npm run db:migrate)
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/estatisticas

# Banco de teste, usado pelo npm test
TEST_DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5433/estatisticas_test

# Liga a lista de Partidas de um Time na API. Só "true" liga; ausente ou qualquer outro valor, desliga.
TEAM_MATCHES_ENABLED=true
