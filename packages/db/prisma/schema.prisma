generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model League {
  slug          String  @id
  name          String
  divisionCode  String  @unique @map("division_code")
  currentSeason String  @map("current_season")
  position      Int
  matches       Match[]
  teamSeasons   TeamSeason[]

  @@map("leagues")
}

model Team {
  slug        String       @id
  name        String
  homeMatches Match[]      @relation("homeTeam")
  awayMatches Match[]      @relation("awayTeam")
  teamSeasons TeamSeason[]

  @@map("teams")
}

model TeamSeason {
  leagueSlug String @map("league_slug")
  season     String
  teamSlug   String @map("team_slug")

  league League @relation(fields: [leagueSlug], references: [slug], onDelete: Cascade)
  team   Team   @relation(fields: [teamSlug], references: [slug])

  @@id([leagueSlug, season, teamSlug])
  @@map("team_seasons")
}

model Match {
  id           Int      @id @default(autoincrement())
  leagueSlug   String   @map("league_slug")
  season       String
  date         DateTime @db.Date
  homeTeamSlug String   @map("home_team_slug")
  awayTeamSlug String   @map("away_team_slug")
  homeGoals    Int      @map("home_goals")
  awayGoals    Int      @map("away_goals")
  homeShotsOnTarget Int @map("home_shots_on_target")
  awayShotsOnTarget Int @map("away_shots_on_target")
  homeYellowCards   Int @map("home_yellow_cards")
  awayYellowCards   Int @map("away_yellow_cards")
  homeRedCards      Int @map("home_red_cards")
  awayRedCards      Int @map("away_red_cards")

  league   League @relation(fields: [leagueSlug], references: [slug], onDelete: Cascade)
  homeTeam Team   @relation("homeTeam", fields: [homeTeamSlug], references: [slug])
  awayTeam Team   @relation("awayTeam", fields: [awayTeamSlug], references: [slug])

  @@unique([leagueSlug, season, homeTeamSlug, awayTeamSlug])
  @@map("matches")
}
